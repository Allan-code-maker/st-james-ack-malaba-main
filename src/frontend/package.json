{
  "name": "st-james-ack-malaba",
  "description": "Official website for St. James Anglican Church of Kenya (ACK), Malaba — serving the community through faith, worship, and outreach.",
  "version": "1.0.0",
  "author": "Allan",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=7.0.0",
    "npm": "please use pnpm"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm -r --if-present run check",
    "fix": "pnpm -r --if-present run fix",
    "deploy:local": "dfx deploy",
    "deploy:mainnet": "dfx deploy --network ic",
    "generate": "dfx generate backend",
    "start": "dfx start --background",
    "stop": "dfx stop"
  },
  "devDependencies": {
    "sharp": "^0.34.4"
  },
  "dependencies": {
    "@dfinity/agent": "^2.1.3",
    "@dfinity/auth-client": "^2.1.3",
    "@dfinity/candid": "^2.1.3",
    "@dfinity/identity": "^2.1.3",
    "@dfinity/principal": "^2.1.3"
  }
}